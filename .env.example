# Copier ce fichier en .env (a la racine du depot) et remplir les valeurs.
# .env est exclu de Git (.gitignore) -- ne jamais committer de vraie cle ici.

# --- Base de donnees (requis) ---
DATABASE_URL=postgresql://postgres:carbongpt@localhost:5432/carbongpt

# --- IA (requis pour les fonctions IA) ---
# Generation de texte (redaction, revue, extraction, argument de defendabilite).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Embeddings uniquement (Anthropic n'en propose pas).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Securite (optionnel mais recommande) ---
# Sans elle, tous les endpoints de l'API sont ouverts sans authentification
# (voir CLAUDE.md SS4).
CARBONGPT_API_KEY=

# --- Optionnel ---
# Recherche web (veille reglementaire, verification de faits)
SERPER_API_KEY=
